// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String          @id @default(uuid())
  email            String          @unique
  username         String          @unique
  fcmToken         String?         @map("fcm_token")
  dailyGoalMinutes Int             @default(190) @map("daily_goal_minutes")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  deletedAt        DateTime?       @map("deleted_at")

  sentRequests     TimeRequest[]          @relation("SentRequests")
  receivedRequests TimeRequestRecipient[] @relation("ReceivedRequests")
  sentLimitRequests     LimitRequest[]          @relation("SentLimitRequests")
  receivedLimitRequests LimitRequestRecipient[] @relation("ReceivedLimitRequests")
  friendshipsInit  Friendship[]           @relation("User1")
  friendshipsRecv  Friendship[]           @relation("User2")
  appTimes         UserAppTime[]
  appLimits        UserAppLimit[]

  @@index([deletedAt])
  @@map("users")
}

model Friendship {
  id        String   @id @default(uuid())
  userId1   String   @map("user_id_1")
  userId2   String   @map("user_id_2")
  status    String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user1     User     @relation("User1", fields: [userId1], references: [id], onDelete: Cascade)
  user2     User     @relation("User2", fields: [userId2], references: [id], onDelete: Cascade)

  @@unique([userId1, userId2])
  @@index([userId2])
  @@index([userId1, status])
  @@index([userId2, status])
  @@map("friendships")
}

model TimeRequest {
  id              String   @id @default(uuid())
  senderId        String   @map("sender_id")
  amountRequested Int      @map("amount_requested")
  message         String?
  status          String   @default("PENDING") // Overall status: PENDING, APPROVED, DENIED
  appId           String   @map("app_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  sender          User                   @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  app             App                    @relation(fields: [appId], references: [id], onDelete: Cascade)
  recipients      TimeRequestRecipient[]

  @@index([senderId])
  @@index([senderId, status])
  @@index([createdAt])
  @@map("time_requests")
}

model TimeRequestRecipient {
  id              String      @id @default(uuid())
  timeRequestId   String      @map("time_request_id")
  receiverId      String      @map("receiver_id")
  status          String      @default("PENDING") // PENDING, APPROVED, DENIED
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  timeRequest     TimeRequest @relation(fields: [timeRequestId], references: [id], onDelete: Cascade)
  receiver        User        @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([timeRequestId, receiverId])
  @@index([receiverId])
  @@index([receiverId, status])
  @@map("time_request_recipients")
}

model LimitRequest {
  id            String                  @id @default(uuid())
  senderId      String                  @map("sender_id")
  appId         String                  @map("app_id")
  type          String                  // MODIFY, DISABLE, DELETE
  currentLimit  Int                     @map("current_limit")
  proposedLimit Int?                    @map("proposed_limit")
  reason        String?
  status        String                  @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  sender        User                    @relation("SentLimitRequests", fields: [senderId], references: [id], onDelete: Cascade)
  app           App                     @relation(fields: [appId], references: [id], onDelete: Cascade)
  recipients    LimitRequestRecipient[]

  @@index([senderId])
  @@index([senderId, status])
  @@index([createdAt])
  @@map("limit_requests")
}

model LimitRequestRecipient {
  id             String       @id @default(uuid())
  limitRequestId String       @map("limit_request_id")
  receiverId     String       @map("receiver_id")
  status         String       @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  limitRequest   LimitRequest @relation(fields: [limitRequestId], references: [id], onDelete: Cascade)
  receiver       User         @relation("ReceivedLimitRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([limitRequestId, receiverId])
  @@index([receiverId])
  @@index([receiverId, status])
  @@map("limit_request_recipients")
}

model App {
  id           String         @id @default(uuid())
  packageName  String         @unique @map("package_name")
  name         String
  
  userTimes    UserAppTime[]
  userLimits   UserAppLimit[]
  timeRequests TimeRequest[]
  limitRequests LimitRequest[]

  @@map("apps")
}

model UserAppLimit {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  appId      String   @map("app_id")
  dailyLimit Int      @map("daily_limit")
  isEnabled  Boolean  @default(true) @map("is_enabled")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  app        App      @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([userId, appId])
  @@index([userId, isEnabled])
  @@map("user_app_limits")
}

model UserAppTime {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  appId      String   @map("app_id")
  timeSpent  Int      @default(0) @map("time_spent")
  date       DateTime @default(now()) @db.Date

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  app        App      @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([userId, appId, date])
  @@index([userId, date])
  @@index([date])
  @@map("user_app_times")
}
