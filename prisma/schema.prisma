// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED

  @@map("request_status")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED

  @@map("friendship_status")
}

model User {
  id               String          @id @default(uuid())
  email            String          @unique
  username         String          @unique
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  deviceTokens     DeviceToken[]
  sentRequests     TimeRequest[]          @relation("Requester")
  receivedRequests TimeRequestRecipient[] @relation("Approver")
  friendshipsInit  Friendship[]           @relation("User1")
  friendshipsRecv  Friendship[]           @relation("User2")
  appTimes         UserAppTime[]
  appLimits        UserAppLimit[]

  @@map("users")
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  deviceOs  String?  @map("device_os")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_tokens")
}

model Friendship {
  id        String           @id @default(uuid())
  userId1   String           @map("user_id_1")
  userId2   String           @map("user_id_2")
  status    FriendshipStatus @default(PENDING)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  user1     User     @relation("User1", fields: [userId1], references: [id], onDelete: Cascade)
  user2     User     @relation("User2", fields: [userId2], references: [id], onDelete: Cascade)

  @@unique([userId1, userId2])
  @@map("friendships")
}

model TimeRequest {
  id              String        @id @default(uuid())
  requesterId     String        @map("requester_id")
  amountRequested Int           @map("amount_requested")
  message         String?
  status          RequestStatus @default(PENDING)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  requester       User                   @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipients      TimeRequestRecipient[]

  @@map("time_requests")
}

model TimeRequestRecipient {
  id              String        @id @default(uuid())
  timeRequestId   String        @map("time_request_id")
  approverId      String        @map("approver_id")
  status          RequestStatus @default(PENDING)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  timeRequest     TimeRequest @relation(fields: [timeRequestId], references: [id], onDelete: Cascade)
  approver        User        @relation("Approver", fields: [approverId], references: [id], onDelete: Cascade)

  @@unique([timeRequestId, approverId])
  @@map("time_request_recipients")
}

model App {
  id          String        @id @default(uuid())
  packageName String        @unique @map("package_name")
  name        String
  
  userTimes   UserAppTime[]
  userLimits  UserAppLimit[]

  @@map("apps")
}

model UserAppLimit {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  appId      String   @map("app_id")
  dailyLimit Int      @map("daily_limit")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  app        App      @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([userId, appId])
  @@map("user_app_limits")
}

model UserAppTime {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  appId      String   @map("app_id")
  timeSpent  Int      @default(0) @map("time_spent")
  date       DateTime @default(now()) @db.Date

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  app        App      @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([userId, appId, date])
  @@map("user_app_times")
}
